<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow both www and non-www domains without 404s
  # Serve existing static files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Do not rewrite API or uploads endpoints when proxied through Passenger/Node
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/uploads/

  # Fallback all other requests to index.html for SPA routing
  RewriteRule ^ index.html [L]
</IfModule>
